                                <text>
                                    <text-style ref="ts1">前天的话</text-style>
                                </text>
                                <text-style-def id="ts1">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" shadowColor="0 0 0 0.75" shadowOffset="5 315" alignment="center"/>
