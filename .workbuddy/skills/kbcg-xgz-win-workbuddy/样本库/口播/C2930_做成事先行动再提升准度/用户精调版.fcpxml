                                <param name="展平" key="9999/999166631/999166633/2/351" value="1"/>
                                <param name="对齐" key="9999/999166631/999166633/2/354/999169573/401" value="1 (居中)"/>
                                <param name="颜色" key="9999/999166631/999166633/5/999166635/14/16" value="1 0.832346 0.473206"/>
                                <param name="融合模式" key="9999/999166631/999166633/5/999166635/21/25/5" value="1 (重复)"/>
                                <text>
                                    <text-style ref="ts12">无论是他本身</text-style>
