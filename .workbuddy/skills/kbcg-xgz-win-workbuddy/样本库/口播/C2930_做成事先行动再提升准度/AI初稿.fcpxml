uzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title></asset-clip><asset-clip ref="rA" offset="4251247/60000s" start="137137/1500s" duration="23023/800s" name="那么企图心它是有的那我分析下来的话我觉得应该就是属于第二种了就是它的思想包袱太重了太过于沉重就考虑决策一件事情他想的东西太复杂了他肯定会想着我要拍一条视频的话我又要把选题给想好我要把脚本给想好我还要想着这条视频他怎么能够去获客然后乱七八糟的就是当我们不断地去想复杂的时候" tcFormat="NDF" audioRole="dialogue"><title ref="rTitle" lane="1" offset="137137/1500s" duration="21021/10000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts49">那么企图心它是有的</text-style></text><text-style-def id="ts49"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="2805803/30000s" duration="21021/20000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts50">那我分析下来的话</text-style></text><text-style-def id="ts50"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="5674669/60000s" duration="11011/20000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts51">我觉得应该就是</text-style></text><text-style-def id="ts51"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="2853851/30000s" duration="11011/7500s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts52">属于第二种了</text-style></text><text-style-def id="ts52"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="193193/2000s" duration="133133/60000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts53">就是它的思想包袱</text-style></text><text-style-def id="ts53"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="5928923/60000s" duration="67067/60000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts54">太重了</text-style></text><text-style-def id="ts54"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="599599/6000s" duration="1001/1250s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts55">太过于沉重</text-style></text><text-style-def id="ts55"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="3022019/30000s" duration="53053/30000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts56">就考虑决策一件事情</text-style></text><text-style-def id="ts56"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="64064/625s" duration="187187/60000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts57">他想的东西太复杂了</text-style></text><text-style-def id="ts57"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="6337331/60000s" duration="31031/30000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts58">他肯定会想着</text-style></text><text-style-def id="ts58"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="2133131/20000s" duration="77077/60000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts59">我要拍一条视频的话</text-style></text><text-style-def id="ts59"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="647647/6000s" duration="37037/15000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts60">我又要把选题给想好</text-style></text><text-style-def id="ts60"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="1104103/10000s" duration="53053/30000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts61">我要把脚本给想好</text-style></text><text-style-def id="ts61"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="1682681/15000s" duration="1001/600s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts62">我还要想着这条视频</text-style></text><text-style-def id="ts62"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="853853/7500s" duration="9009/4000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts63">他怎么能够去获客</text-style></text><text-style-def id="ts63"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="6965959/60000s" duration="67067/60000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts64">然后乱七八糟的</text-style></text><text-style-def id="ts64"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="1172171/10000s" duration="67067/60000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts65">就是当我们不断地去</text-style></text><text-style-def id="ts65"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="7100093/60000s" duration="7007/3750s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts66">想复杂的时候</text-style></text><text-style-def id="ts66"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title></asset-clip><asset-clip ref="rA" offset="1494493/15000s" start="3860857/30000s" duration="2085083/30000s" name="其实我觉得任何事情不仅仅是拍视频小到工作大到你的人生的一些决策我觉得很多东西都是源自于你的想法太复杂你没有活在当下我经常会说人一定要活在当下因为你不活在当下你的思想就只会往两个地方去飘移一个是什么呢一个是过去你会不断地在过去的苦恼当中悔恨当中对吧去挣扎去漫游另外一边就飘到什么地方呢你会飘到未来那就依然拿拍视频这件事情来讲你可能会说万一我这个视频发出去没人看怎么办万一我拍了这个视频它没有结果怎么办万一这件事情我做了很久它对吧得不到正反馈乱七八糟怎么办但是你发现没有不管是过去还是未来它都是无效的只有当下此时此刻它才是绝对有效的" tcFormat="NDF" audioRole="dialogue"><title ref="rTitle" lane="1" offset="3860857/30000s" duration="7007/1200s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts67">其实我觉得任何事情</text-style></text><text-style-def id="ts67"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="84084/625s" duration="89089/60000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts68">不仅仅是拍视频</text-style></text><text-style-def id="ts68"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="8161153/60000s" duration="7007/2500s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts69">小到工作大到</text-style></text><text-style-def id="ts69"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="8329321/60000s" duration="19019/15000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts70">你的人生的一些决策</text-style></text><text-style-def id="ts70"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="2801799/20000s" duration="17017/15000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts71">我觉得很多东西</text-style></text><text-style-def id="ts71"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="1694693/12000s" duration="7007/6000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts72">都是源自于</text-style></text><text-style-def id="ts72"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="569569/4000s" duration="17017/10000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts73">你的想法太复杂</text-style></text><text-style-def id="ts73"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="2881879/20000s" duration="1001/400s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts74">你没有活在当下</text-style></text><text-style-def id="ts74"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="2931929/20000s" duration="71071/60000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts75">我经常会说</text-style></text><text-style-def id="ts75"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="4433429/30000s" duration="43043/30000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts76">人一定要活在当下</text-style></text><text-style-def id="ts76"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="559559/3750s" duration="37037/20000s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts77">因为你不活在当下</text-style></text><text-style-def id="ts77"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="1812811/12000s" duration="7007/3750s"><param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220"/><text><text-style ref="ts78">你的思想就只会往</text-style></text><text-style-def id="ts78"><text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/></text-style-def></title><title ref="rTitle" lane="1" offset="9176167/60000s" duration="3003/1000s"><param name="Positi