        <event name="粗剪听审" uid="3B92F58F-4EF9-45B0-8C2F-AD3B8A7ECBA9">
            <project name="2026-08-11_IP做不起来是因为没人记住你_粗剪听审" uid="BC1C4984-7C0E-408B-A600-DBEF1915E6E8" modDate="2026-08-11 13:26:26 +0800">
                <sequence format="r1" duration="2399900/6000s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                    <spine>
                        <asset-clip ref="r2" offset="0s" name="C2901_粗剪段01" start="6700/6000s" duration="104300/6000s" tcFormat="NDF" audioRole="dialogue">
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="71/60s" duration="101/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts1">你想要把</text-style>
                                    <text-style ref="ts2">IP</text-style>
                                    <text-style ref="ts3">给做起来</text-style>
                                </text>
                                <text-style-def id="ts1">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts2">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts3">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="43/15s" duration="43/30s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts4">首先有个</text-style>
                                    <text-style ref="ts5">大前提</text-style>
                                </text>
                                <text-style-def id="ts4">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts5">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="43/10s" duration="41/30s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts6">就是你这个账号</text-style>
                                </text>
                                <text-style-def id="ts6">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="17/3s" duration="6/5s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts7">或者说你这个人</text-style>
                                </text>
                                <text-style-def id="ts7">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="103/15s" duration="7/4s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts8">可以</text-style>
                                    <text-style ref="ts9">被别人记住</text-style>
                                </text>
                                <text-style-def id="ts8">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts9">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="517/60s" duration="6/5s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts10">如果说做不到</text-style>
                                </text>
                                <text-style-def id="ts10">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="589/60s" duration="8/5s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts11">让别人</text-style>
                                    <text-style ref="ts12">记住</text-style>
                                </text>
                                <text-style-def id="ts11">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts12">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="137/12s" duration="13/20s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts13">那你这个账号</text-style>
                                </text>
                                <text-style-def id="ts13">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="181/15s" duration="101/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts14">是</text-style>
                                    <text-style ref="ts15">很难做起来</text-style>
                                    <text-style ref="ts16">的</text-style>
                                </text>
                                <text-style-def id="ts14">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts15">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts16">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="55/4s" duration="19/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts17">那么OK</text-style>
                                </text>
                                <text-style-def id="ts17">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="211/15s" duration="43/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts18">这套视频的话</text-style>
                                </text>
                                <text-style-def id="ts18">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="887/60s" duration="223/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts19">依然是关于做</text-style>
                                    <text-style ref="ts20">IP</text-style>
                                    <text-style ref="ts21">的分享</text-style>
                                </text>
                                <text-style-def id="ts19">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts20">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts21">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                        </asset-clip>
                        <asset-clip ref="r2" offset="104300/6000s" name="C2901_粗剪段01" start="119900/6000s" duration="49600/6000s" tcFormat="NDF" audioRole="dialogue">
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="1199/60s" duration="4/5s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts22">我们想一下</text-style>
                                </text>
                                <text-style-def id="ts22">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="1247/60s" duration="29/30s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts23">就是在以前</text-style>
                                </text>
                                <text-style-def id="ts23">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="87/4s" duration="31/30s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts24">我们读书的时候</text-style>
                                </text>
                                <text-style-def id="ts24">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="1367/60s" duration="77/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts25">一个班级里面</text-style>
                                </text>
                                <text-style-def id="ts25">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="361/15s" duration="7/4s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts26">几十号人</text-style>
                                </text>
                                <text-style-def id="ts26">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="1549/60s" duration="73/30s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts27">你的同学你还</text-style>
                                    <text-style ref="ts28">记得谁</text-style>
                                </text>
                                <text-style-def id="ts27">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts28">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" alignment="center" />
                                </text-style-def>
                            </title>
                        </asset-clip>
                        <asset-clip ref="r2" offset="153900/6000s" name="C2901_粗剪段01" start="169500/6000s" duration="87300/6000s" tcFormat="NDF" audioRole="dialogue">
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="143/5s" duration="13/10s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts29">我拿我自己举例子</text-style>
                                </text>
                                <text-style-def id="ts29">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="299/10s" duration="8/5s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts30">因为我读的学校</text-style>
                                </text>
                                <text-style-def id="ts30">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="63/2s" duration="2/1s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts31">还是比较多的</text-style>
                                </text>
                                <text-style-def id="ts31">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="67/2s" duration="29/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts32">前前后后</text-style>
                                </text>
                                <text-style-def id="ts32">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="2039/60s" duration="39/20s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts33">几百个同学</text-style>
                                </text>
                                <text-style-def id="ts33">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="539/15s" duration="109/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts34">但是唯一能让我</text-style>
                                    <text-style ref="ts35">记住</text-style>
                                </text>
                                <text-style-def id="ts34">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts35">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="151/4s" duration="43/20s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts36">的话可能符合这么几点</text-style>
                                </text>
                                <text-style-def id="ts36">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="399/10s" duration="53/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts37">首先第一个</text-style>
                                </text>
                                <text-style-def id="ts37">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="2447/60s" duration="6/5s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts38">我觉得他一定是</text-style>
                                </text>
                                <text-style-def id="ts38">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                            </title>
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="2519/60s" duration="49/60s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts39">得有</text-style>
                                    <text-style ref="ts40">身份</text-style>
                                    <text-style ref="ts41">的</text-style>
                                </text>
                                <text-style-def id="ts39">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts40">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="0.995808 0.800124 0.399987 1" alignment="center" />
                                </text-style-def>
                                <text-style-def id="ts41">
                                    <text-style font="XQjuzhentiZJSY" fontSize="50" fontFace="Regular" fontColor="1 1 1 1" alignment="center" />
                                </text-style-def>
