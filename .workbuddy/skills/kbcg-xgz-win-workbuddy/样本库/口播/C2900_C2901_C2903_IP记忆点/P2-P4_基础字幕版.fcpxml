                        <asset-clip ref="r2" offset="241200/6000s" name="C2901_粗剪段01" start="263100/6000s" duration="3800/6000s" tcFormat="NDF" audioRole="dialogue">
                            <title ref="rHumanCaptionBasicTitle" lane="1" offset="659/15s" duration="11/20s">
                                <param name="Position" key="9999/999166631/999166633/1/100/101" value="0 -220" />
                                <text>
                                    <text-style ref="ts42">班长</text-style>
                                </text>
